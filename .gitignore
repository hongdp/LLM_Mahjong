wandb/
logs/

# Experiment outputs: keep the written records under version control
# (ml-experiment-tracking requires them to be durable), exclude the heavy
# artifacts — checkpoints, tensorboard event files, rollout transcripts.
experiments/*
!experiments/INDEX.md
!experiments/FINDINGS.md
!experiments/LEADERBOARD.md
!experiments/elo_league/
!experiments/elo_league/anchors.json
!experiments/designs/
!experiments/reports/
!experiments/configs/
!experiments/*/
experiments/*/*
!experiments/*/EXPERIMENT.md
!experiments/*/config*.json
!experiments/designs/*.md
!experiments/reports/*.md
!experiments/configs/*.json
!experiments/elo_league/anchors.json
# a pool file IS a scale definition (which models, which condition, which
# fingerprints) — it must be reviewable in git even though its matches are not
!experiments/elo_league/hanchan/
experiments/elo_league/hanchan/*
!experiments/elo_league/hanchan/anchors*.json
# rating system v2: the registry is the identity map (entity -> checkpoint
# content hash); the match ledger itself stays out of git (it grows without
# bound and is pure data)
!experiments/rating/
experiments/rating/*
!experiments/rating/registry.json

# IDE agent caches
.antigravitycli/

# IDEs and Editors
.idea/
.vscode/
*.swp
*.swo
.DS_Store
